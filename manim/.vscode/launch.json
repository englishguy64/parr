                "manim",
                "-pql",
                "${fileDirname}/HelloCircle.py",
                "HelloCircle"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Manim: Fast Render (Low Quality)",
            "type": "debugpy",
            "request": "launch",
            "program": "-m",
            "args": [
                "manim",
                "-ql",
                "${fileDirname}/HelloCircle.py",
                "HelloCircle"
            ],
            "console": "integratedTerminal"
        }
